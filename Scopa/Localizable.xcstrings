        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca qualsiasi cosa per comprarla. È tua per sempre e va subito sul tuo tavolo."
          }
        }
      }
    },
    "Tap anything you own to switch to it." : {
