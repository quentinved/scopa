    "Playing in teams with friends? Tap a player to sit them across from you. A friend at a table of bots is your partner from the start." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous jouez en équipes avec des amis ? Touchez un joueur pour l'asseoir en face de vous. Un ami à une table de bots est votre partenaire dès le départ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giochi a squadre con gli amici? Tocca un giocatore per farlo sedere di fronte a te. Un amico a un tavolo di bot è il tuo compagno fin da subito."
          }
        }
      }
    },
    "Playing in teams? Put both names on one line." : {
      "localizations" : {
