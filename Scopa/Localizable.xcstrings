      }
    },
    "Nearby tables need both phones on the same Wi-Fi, or Bluetooth on." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les tables à proximité, les deux téléphones doivent être sur le même Wi-Fi, ou avoir le Bluetooth activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tavoli vicini richiedono i due telefoni sulla stessa rete Wi-Fi, o il Bluetooth acceso."
          }
        }
      }
    },
    "Nearby, online or ranked — anyone who is not the machine." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À proximité, en ligne ou en classé — tout le monde sauf la machine."
