            "value" : "Il tavolo"
          }
        }
      }
    },
    "The table is swept: %@ denari are in your purse — and the tables you set can share what you end level on." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La table est balayée : %@ deniers sont dans votre bourse — et aux tables que vous ouvrez, une catégorie à égalité peut rapporter un point à chacun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tavolo è pulito: %@ denari sono nel tuo borsellino — e i tavoli che apri possono dividere le categorie in parità."
          }
        }
      }
    },
    "The table is swept: %@ denari are in your purse." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La table est balayée : %@ deniers sont dans votre bourse."
