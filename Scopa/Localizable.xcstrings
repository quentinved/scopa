    "On your turn, play one card. It takes the cards it matches." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À votre tour, jouez une carte. Elle prend les cartes qui lui correspondent."
