          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sola scopa non conta: quella fatta con l'ultimissima carta della smazzata, perché a quel punto il tavolo si svuota per forza."
          }
        }
      }
    },
