    "One card on the table, and your 3 matches it. Another scopa for the team." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une carte sur la table, et votre 3 la prend. Encore une scopa pour l'équipe."
          }
