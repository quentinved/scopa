            "value" : "Nessuno ha segnato"
          }
        }
      }
    },
    "Nobody to list yet — only friends who already play Scopa show up here. Invite a friend anyway and Game Center will ask them on their phone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne pour l'instant — seuls les amis qui jouent déjà à Scopa apparaissent ici. Invitez-en un quand même : Game Center lui enverra la demande sur son téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessuno da mostrare — qui compaiono solo gli amici che giocano già a Scopa. Invita lo stesso un amico: Game Center glielo chiederà sul suo telefono."
          }
        }
      }
    },
    "Nonna taught me." : {
      "localizations" : {
