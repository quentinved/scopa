    "each card, in gold" : {
      "comment" : "Oro odds line: how many earned packs it takes for one given card of this rarity to come out gold",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "chaque carte, en or"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ogni carta, in oro"
          }
        }
      }
    },
    "Each one pays when it is done. The laurel is for finishing all of them." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque tâche rapporte dès qu'elle est faite. Le laurier récompense celui qui les termine toutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuno paga quando è fatto. L'alloro è per chi li finisce tutti."
          }
        }
      }
    },
    "Each scopa adds one more point." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
