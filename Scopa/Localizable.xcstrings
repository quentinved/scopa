    },
    "Tap anything to buy it. It is yours for good and goes on your table straight away." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un objet pour l'acheter. Il est à vous pour de bon et va directement sur votre table."
