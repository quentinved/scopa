        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les invitations arrivent chez vos amis Game Center sous forme de notification. Avec un mot secret, pas besoin d'être amis : choisissez-en un ensemble et tapez-le tous les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli inviti vanno ai tuoi amici Game Center e arrivano come notifica. Una parola convenuta non richiede amicizia: mettetevi d'accordo e scrivetela entrambi."
          }
        }
      }
    },
