        }
      }
    },
    "A nudge at the hour you usually play and a last call in the evening, on the days you have not played yet." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rappel à l'heure où vous jouez d'habitude, et un dernier le soir, les jours où vous n'avez pas encore joué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un promemoria all'ora in cui giochi di solito e un ultimo richiamo la sera, nei giorni in cui non hai ancora giocato."
          }
        }
      }
    },
    "A nudge when tomorrow's deal is ready?" : {
      "localizations" : {
