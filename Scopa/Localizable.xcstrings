    },
    "One and two make three, so your 3 takes the ace and the 2. That makes all three." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un et deux font trois : votre 3 ramasse l'as et le 2. Et voilà les trois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno più due fa tre: il tuo 3 prende l'asso e il 2. Ecco tutti e tre."
          }
        }
      }
    },
    "One card a day. Another tomorrow." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une carte par jour. Une autre demain."
          }
