        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vicino, online o in classifica — chiunque tranne la macchina."
          }
        }
      }
    },
    "Nearby, or pass the phone" : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À proximité, ou en se passant le téléphone"
