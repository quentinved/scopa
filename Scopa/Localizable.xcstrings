      }
    },
    "Today's deal and the tables with denari on them are always played against the hard bot: everybody there faces the same one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La donne du jour et les tables avec des deniers en jeu se jouent toujours contre le bot difficile : tout le monde y affronte le même."
