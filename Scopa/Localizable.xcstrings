      }
    },
    "For every card you hold I say what it would take, and what it would cost. When Hugo plays, I say what he just did to you." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour chaque carte de votre main, je vous dis ce qu'elle prendrait et ce qu'elle vous coûterait. Quand Hugo joue, je vous explique ce qu'il vient de vous faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ogni carta che hai in mano ti dico cosa prenderebbe e cosa ti costerebbe. Quando gioca Hugo, ti dico cosa ti ha appena fatto."
          }
