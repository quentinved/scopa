      }
    },
    "Four in two teams, ten cards each, nothing on the table to start" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quatre en deux équipes, dix cartes chacun, rien sur la table au départ"
          }
        },
