            "value" : "Nelle vicinanze, o passandosi il telefono"
          }
        }
      }
    },
    "Needs Game Center, which is signed in to from the iPhone's Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite Game Center (connexion depuis les Réglages de l'iPhone)."
