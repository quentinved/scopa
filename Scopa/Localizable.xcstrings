      }
    },
    "Tell a friend the word however you like — a message, out loud, over the phone. Whoever types it first waits at the table until the other arrives." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez le mot à un ami comme vous voulez — par message, de vive voix, au téléphone. Le premier à le taper attend l'autre à la table."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di' la parola a un amico come vuoi — un messaggio, a voce, al telefono. Chi la scrive per primo aspetta al tavolo che arrivi l'altro."
          }
        }
      }
    },
    "Tell us what is missing" : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-nous ce qui manque"
