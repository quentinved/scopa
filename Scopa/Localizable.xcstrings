    "A pack holds a few things picked at random from the shelves below, for less than buying them one by one. Never anything you already own. Odds shows the chances." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paquet contient quelques objets tirés au hasard dans les rayons ci-dessous, pour moins cher qu'à l'unité. Jamais un objet que vous avez déjà. « Probabilités » donne les chances."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pacchetto contiene alcune cose scelte a caso dagli scaffali qui sotto, per meno che comprarle una a una. Mai qualcosa che hai già. «Probabilità» mostra le possibilità."
          }
        }
      }
    },
