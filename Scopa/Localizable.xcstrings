        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicci cosa manca"
          }
        }
      }
    },
    "Ten cards each and nothing on the table. %@, across from you, is your partner." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dix cartes chacun et rien sur la table. %@, en face de vous, est votre partenaire."
