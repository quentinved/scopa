        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un asso prende tutto quello che c'è sul tavolo. Non se ne scopre mai uno all'inizio: i tuoi sono in mano."
          }
        }
      }
    },
