      }
    },
    "Today's deal, the week and the wheel side by side, and every button says what it does. The shop scrolls smoothly, and your app icon can be changed from Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La donne du jour, la semaine et la roue côte à côte, et chaque bouton dit ce qu'il fait. La boutique défile en douceur, et l'icône de l'app se change depuis les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La smazzata del giorno, la settimana e la ruota una accanto all'altra, e ogni pulsante dice cosa fa. Il negozio scorre fluido, e l'icona dell'app si cambia dalle Impostazioni."
          }
        }
      }
    },
