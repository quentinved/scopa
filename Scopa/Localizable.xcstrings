        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamburello, fisarmonica, mandolino. Prova a stare fermo"
          }
        }
      }
    },
    "Tap a card and I will tell you what it would do." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une carte et je vous dirai ce qu'elle ferait."
