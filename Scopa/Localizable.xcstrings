          "stringUnit" : {
            "state" : "translated",
            "value" : "Come il settebello, vale un punto da solo. Eccolo, sul tavolo."
          }
        }
      }
    },
    "Linen, cross-stitched by a very patient aunt" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lin, brodé au point de croix par une tante très patiente"
