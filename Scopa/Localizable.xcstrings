    "Taking it all with an ace is not a scopa: the ace did the work, not you." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ramasser avec un as n'est pas une scopa : c'est l'as qui a fait le travail, pas vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendere tutto con l'asso non è scopa: il lavoro l'ha fatto l'asso, non tu."
          }
        }
      }
    },
    "Taking your seats" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installation à la table"
