        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopa non può vedere i tuoi amici. Attivalo nelle Impostazioni dell'iPhone, alla voce Game Center."
          }
        }
      }
    },
    "Scopa is the Italian for broom. It is the point everyone plays for." : {
      "localizations" : {
        "fr" : {
