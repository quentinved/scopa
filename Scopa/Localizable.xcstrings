    },
    "How rare a thing is, from everyday to one of a kind. Rarer things turn up less often in packs." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rareté d'un objet, du plus courant au plus unique. Les plus rares sortent moins souvent des paquets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto è rara una cosa, dalla più comune alla più unica. Le più rare escono meno spesso dai pacchetti."
          }
        }
      }
    },
    "How the figures and pips on every card are drawn." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La façon dont les figures et les symboles de chaque carte sont dessinés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come sono disegnati le figure e i semi di ogni carta."
